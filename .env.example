# Supabase — публичные ключи фронтенда (безопасны для клиента)
# Взять в Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Telegram — СЕРВЕРНЫЕ секреты для приёма заявок (/api/lead).
# БЕЗ префикса NEXT_PUBLIC_ — токен не должен попадать в клиентский бандл.
# BOT_TOKEN: у @BotFather. CHAT_ID: id чата/канала, куда шлём заявки.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
